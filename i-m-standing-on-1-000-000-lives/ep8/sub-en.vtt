m 0 0 l 102 0 l 102 58 l 0 58

00:02:33.920 --> 00:02:35.920
m 0 0 l 102 0 l 102 58 l 0 58

00:02:33.920 --> 00:02:35.920
m 0 0 l 102 0 l 102 58 l 0 58

00:02:33.920 --> 00:02:35.920
<b><u></u></b>\h\h\h\h\h\h\hMakuah\h\h\h\h\h\h\h

00:02:33.920 --> 00:02:35.920
<b><u></u></b>\hHakozaki Kusue\h

00:02:33.920 --> 00:02:35.920
<b><u></u></b>\h\h\h\h\hShindou Iu\h\h\h\h\h

00:02:33.920 --> 00:02:35.920
Search for cargo bound for Radodorbo

00:02:35.920 --> 00:02:38.010
